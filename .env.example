# ─── LaunchPad-AI Environment Variables ──────────────────────
# Copy this to .env and fill in real values. NEVER commit .env.
#
# Secrets (GitHub App key, webhook secret) live in Secret Manager
# at runtime — they are NOT set as env vars in production.
# ──────────────────────────────────────────────────────────────

# Google Cloud / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=launchpad-ai-506616
GOOGLE_CLOUD_LOCATION=asia-south1

# Gemini model (e.g. gemini-2.5-flash, gemini-3.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# GitHub App configuration
GITHUB_APP_ID=4721900

# ─── Local development only (not used in Cloud Run) ──────────
# For local testing with the Firestore emulator:
# FIRESTORE_EMULATOR_HOST=localhost:8080
