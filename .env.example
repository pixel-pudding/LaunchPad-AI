# ─── LaunchPad-AI Environment Variables ──────────────────────
# Copy this to .env and fill in real values. NEVER commit .env.
#
# Secrets (GitHub App key, webhook secret) live in Secret Manager
# at runtime — they are NOT set as env vars in production.
# ──────────────────────────────────────────────────────────────

# Google Cloud / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=launchpad-ai-506616
GOOGLE_CLOUD_LOCATION=asia-south1

# Gemini model (Gemini 3.5 Flash or newer — required by hackathon)
GEMINI_MODEL=gemini-3.5-flash

# Imagen configuration (Vertex AI)
# Set IMAGE_MOCK_MODE=0 for live Vertex AI Imagen generation, or 1 for fast dev SVG mock
IMAGE_MOCK_MODE=0
IMAGEN_MODEL=imagen-3.0-generate-002

# GitHub App & Portfolio configuration
GITHUB_APP_ID=4721900
# Target portfolio repo is configured dynamically via the web onboarding (Step 2).
# PORTFOLIO_REPO is optional and serves only as an unconfigured fallback:
# PORTFOLIO_REPO=
# Set PORTFOLIO_AUTO_MERGE=1 to automatically merge portfolio card PRs, or 0 to keep them open for manual review
PORTFOLIO_AUTO_MERGE=1

# ─── Local development only (not used in Cloud Run) ──────────
# For local testing with the Firestore emulator:
# FIRESTORE_EMULATOR_HOST=localhost:8080

